<Project>
  <!--
    Civil 3D 2023 field-safety final boundary.
    The repository has a historical staged-repair pipeline. Running this target
    immediately before CE.Tools.Civil3D compilation guarantees that no older repair
    script can re-introduce crash-prone Sewer/Cadastral/FeatureLine code after the
    final August 21 safety pass.
  -->
  <Target Name="CEApplyAugust21CrossDisciplineFatalSafety"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'CE.Tools.Civil3D' and '$(AutoCADVersion)' == '2023' and '$(OS)' == 'Windows_NT'">
    <Message Text="Applying final Civil 3D 2023 cross-discipline fatal-safety boundary..." Importance="high" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\Apply-August21-CrossDisciplineFatalSafety-BeforeBuild.ps1&quot; -RepoRoot &quot;$(MSBuildThisFileDirectory)&quot;" />
  </Target>

  <Target Name="CEApplyAugust23PlatformDynamicGrading"
          AfterTargets="CEApplyAugust21CrossDisciplineFatalSafety"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'CE.Tools.Civil3D' and '$(AutoCADVersion)' == '2023' and '$(OS)' == 'Windows_NT'">
    <Message Text="Applying final Civil 3D 2023 Platform dynamic-grading boundary..." Importance="high" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\Repair-August23-PlatformDynamicGrading-Civil3D2023.ps1&quot; -RepoRoot &quot;$(MSBuildThisFileDirectory)&quot;" />
  </Target>

  <Target Name="CEApplyAugust24DynamicGridCivilSurfaceCompileFix"
          AfterTargets="CEApplyAugust23PlatformDynamicGrading"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'CE.Tools.Civil3D' and '$(AutoCADVersion)' == '2023' and '$(OS)' == 'Windows_NT'">
    <Message Text="Qualifying Dynamic Grid Civil Surface references before compilation..." Importance="high" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\Repair-August24-DynamicGridCivilSurfaceCompileFix-Civil3D2023.ps1&quot; -RepoRoot &quot;$(MSBuildThisFileDirectory)&quot;" />
  </Target>

  <Target Name="CEApplyAugust24FinalCompileCompatibility"
          AfterTargets="CEApplyAugust24DynamicGridCivilSurfaceCompileFix"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'CE.Tools.Civil3D' and '$(AutoCADVersion)' == '2023' and '$(OS)' == 'Windows_NT'">
    <Message Text="Applying final Civil 3D 2023 compile compatibility boundary..." Importance="high" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\Repair-August24-FinalCompileCompatibility-Civil3D2023.ps1&quot; -RepoRoot &quot;$(MSBuildThisFileDirectory)&quot;" />
  </Target>

  <Target Name="CEApplyAugust24FloodProductionCulvertMenu"
          AfterTargets="CEApplyAugust24FinalCompileCompatibility"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'CE.Tools.Civil3D' and '$(AutoCADVersion)' == '2023' and '$(OS)' == 'Windows_NT'">
    <Message Text="Finalizing Flood Production catchment and culvert workflow..." Importance="high" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\Repair-August24-FloodProductionCulvertMenu-Civil3D2023.ps1&quot; -RepoRoot &quot;$(MSBuildThisFileDirectory)&quot;" />
  </Target>

  <Target Name="CEApplyAugust25CadSupplementaryFieldMultiSelect"
          AfterTargets="CEApplyAugust24FloodProductionCulvertMenu"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'CE.Tools.Civil3D' and '$(AutoCADVersion)' == '2023' and '$(OS)' == 'Windows_NT'">
    <Message Text="Finalizing CAD Supplementary multi-select field behavior..." Importance="high" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\Invoke-August25-CadSupplementaryFieldMultiSelect-Civil3D2023.ps1&quot; -RepoRoot &quot;$(MSBuildThisFileDirectory)&quot;" />
  </Target>

  <Target Name="CEApplyAugust26CadSupplementaryGeometrySafety"
          AfterTargets="CEApplyAugust25CadSupplementaryFieldMultiSelect"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'CE.Tools.Civil3D' and '$(AutoCADVersion)' == '2023' and '$(OS)' == 'Windows_NT'">
    <Message Text="Applying August 26 CAD Supplementary geometry/multi-select safety boundary..." Importance="high" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\Repair-August26-CadSupplementaryGeometrySafety-Civil3D2023.ps1&quot; -RepoRoot &quot;$(MSBuildThisFileDirectory)&quot;" />
  </Target>

  <Target Name="CEApplyAugust27DynamicSlopeGridHatch"
          AfterTargets="CEApplyAugust26CadSupplementaryGeometrySafety"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'CE.Tools.Civil3D' and '$(AutoCADVersion)' == '2023' and '$(OS)' == 'Windows_NT'">
    <Message Text="Applying August 27 dynamic slope/grid/road-hatch boundary..." Importance="high" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\Repair-August27-DynamicSlopeGridHatch-Civil3D2023.ps1&quot; -RepoRoot &quot;$(MSBuildThisFileDirectory)&quot;" />
  </Target>

  <Target Name="CEApplySeptember04ConstructionXlineBreakJunctions"
          AfterTargets="CEApplyAugust27DynamicSlopeGridHatch"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'CE.Tools.Civil3D' and '$(AutoCADVersion)' == '2023' and '$(OS)' == 'Windows_NT'">
    <Message Text="Applying September 04 construction XLINE and polyline-junction break boundary..." Importance="high" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\Repair-September04-ConstructionXlineBreakJunctions-Civil3D2023.ps1&quot; -RepoRoot &quot;$(MSBuildThisFileDirectory)&quot;" />
  </Target>

  <Target Name="CEApplySeptember04GridRefreshBreakStability"
          AfterTargets="CEApplySeptember04ConstructionXlineBreakJunctions"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'CE.Tools.Civil3D' and '$(AutoCADVersion)' == '2023' and '$(OS)' == 'Windows_NT'">
    <Message Text="Applying September 04 dynamic-grid refresh and T/X break stability boundary..." Importance="high" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\Repair-September04-GridRefreshAndBreakStability-Civil3D2023.ps1&quot; -RepoRoot &quot;$(MSBuildThisFileDirectory)&quot;" />
  </Target>

  <Target Name="CEApplySeptember04VerifiedJunctionBreak"
          AfterTargets="CEApplySeptember04GridRefreshBreakStability"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'CE.Tools.Civil3D' and '$(AutoCADVersion)' == '2023' and '$(OS)' == 'Windows_NT'">
    <Message Text="Applying tested September 04 T/X junction break boundary..." Importance="high" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\Repair-September04-VerifiedJunctionBreak-Civil3D2023.ps1&quot; -RepoRoot &quot;$(MSBuildThisFileDirectory)&quot;" />
  </Target>

  <Target Name="CEApplySeptember04SiteGridDynamicNoLoop"
          AfterTargets="CEApplySeptember04VerifiedJunctionBreak"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'CE.Tools.Civil3D' and '$(AutoCADVersion)' == '2023' and '$(OS)' == 'Windows_NT'">
    <Message Text="Applying September 04 Site Grid dynamic/no-loop boundary..." Importance="high" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\Repair-September04-SiteGridDynamicNoLoop-Civil3D2023.ps1&quot; -RepoRoot &quot;$(MSBuildThisFileDirectory)&quot;" />
  </Target>

  <Target Name="CEApplySeptember05FieldGeometryCompletion"
          AfterTargets="CEApplySeptember04SiteGridDynamicNoLoop"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'CE.Tools.Civil3D' and '$(AutoCADVersion)' == '2023' and '$(OS)' == 'Windows_NT'">
    <Message Text="Applying September 05 final field-geometry completion boundary..." Importance="high" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\Repair-September05-FieldGeometryCompletion-Civil3D2023.ps1&quot; -RepoRoot &quot;$(MSBuildThisFileDirectory)&quot;" />
  </Target>

  <Target Name="CEApplySeptember09FieldEngineering"
          AfterTargets="CEApplySeptember05FieldGeometryCompletion"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'CE.Tools.Civil3D' and '$(AutoCADVersion)' == '2023' and '$(OS)' == 'Windows_NT'">
    <Message Text="Applying September 09 final field-engineering boundary..." Importance="high" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\Repair-September09-FieldEngineering-Civil3D2023.ps1&quot; -RepoRoot &quot;$(MSBuildThisFileDirectory)&quot;" />
  </Target>

  <!-- Absolute final field-refinement boundary from Civil 3D field testing. -->
  <Target Name="CEApplySeptember09FieldRefinement"
          AfterTargets="CEApplySeptember09FieldEngineering"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'CE.Tools.Civil3D' and '$(AutoCADVersion)' == '2023' and '$(OS)' == 'Windows_NT'">
    <Message Text="Applying September 09 final field-refinement boundary..." Importance="high" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\Repair-September09-FieldRefinement-Civil3D2023.ps1&quot; -RepoRoot &quot;$(MSBuildThisFileDirectory)&quot;" />
  </Target>

  <!-- Absolute final sewer field boundary: must run after all historical and September 09 staged repairs. -->
  <Target Name="CEApplySeptember09SewerSurfaceRulesAlignment"
          AfterTargets="CEApplySeptember09FieldRefinement"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'CE.Tools.Civil3D' and '$(AutoCADVersion)' == '2023' and '$(OS)' == 'Windows_NT'">
    <Message Text="Applying September 09 sewer surface/rules and crash-safe alignment boundary..." Importance="high" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\Repair-September09-SewerSurfaceRulesAlignment-Civil3D2023.ps1&quot; -RepoRoot &quot;$(MSBuildThisFileDirectory)&quot;" />
  </Target>

  <!-- Final September 10 field corrections: run after every older staged mutation. -->
  <Target Name="CEApplySeptember10SewerAuditSequenceDynamicMultiDimension"
          AfterTargets="CEApplySeptember09SewerSurfaceRulesAlignment"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'CE.Tools.Civil3D' and '$(AutoCADVersion)' == '2023' and '$(OS)' == 'Windows_NT'">
    <Message Text="Applying September 10 sewer audit/sequence and dynamic-dimension field corrections..." Importance="high" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\Repair-September10-SewerAuditSequenceDynamicMultiDimension-Civil3D2023.ps1&quot; -RepoRoot &quot;$(MSBuildThisFileDirectory)&quot;" />
  </Target>
</Project>