<Project>
  <!--
    Civil 3D 2023 field-safety final boundary.
    The repository has a historical staged-repair pipeline. Running this target
    immediately before CE.Tools.Civil3D compilation guarantees that no older repair
    script can re-introduce crash-prone Sewer/Cadastral/FeatureLine code after the
    final August 21 safety pass.
  -->
  <Target Name="CEApplyAugust21CrossDisciplineFatalSafety"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'CE.Tools.Civil3D' and '$(AutoCADVersion)' == '2023' and '$(OS)' == 'Windows_NT'">
    <Message Text="Applying final Civil 3D 2023 cross-discipline fatal-safety boundary..." Importance="high" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\Apply-August21-CrossDisciplineFatalSafety-BeforeBuild.ps1&quot; -RepoRoot &quot;$(MSBuildThisFileDirectory)&quot;" />
  </Target>

  <!--
    Platform production finalizer. This runs after the August 21 fatal-safety target
    and immediately before compilation, so the historical staged repair chain cannot
    overwrite the August 23 Platform workflow routes or its dynamic refresh bridge.
  -->
  <Target Name="CEApplyAugust23PlatformDynamicGrading"
          AfterTargets="CEApplyAugust21CrossDisciplineFatalSafety"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'CE.Tools.Civil3D' and '$(AutoCADVersion)' == '2023' and '$(OS)' == 'Windows_NT'">
    <Message Text="Applying final Civil 3D 2023 Platform dynamic-grading boundary..." Importance="high" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\Repair-August23-PlatformDynamicGrading-Civil3D2023.ps1&quot; -RepoRoot &quot;$(MSBuildThisFileDirectory)&quot;" />
  </Target>

  <!--
    The August 23 Grid feedback repair injects Civil surface-level helpers into a
    file that imports both AutoCAD and Civil DatabaseServices namespaces. Qualify
    those helper types after every historical/final repair and immediately before
    CoreCompile so the real Civil 3D references cannot produce CS0104 Surface
    ambiguity.
  -->
  <Target Name="CEApplyAugust24DynamicGridCivilSurfaceCompileFix"
          AfterTargets="CEApplyAugust23PlatformDynamicGrading"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'CE.Tools.Civil3D' and '$(AutoCADVersion)' == '2023' and '$(OS)' == 'Windows_NT'">
    <Message Text="Qualifying Dynamic Grid Civil Surface references before compilation..." Importance="high" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\Repair-August24-DynamicGridCivilSurfaceCompileFix-Civil3D2023.ps1&quot; -RepoRoot &quot;$(MSBuildThisFileDirectory)&quot;" />
  </Target>

  <!--
    Final semantic compile compatibility. This is deliberately the last source
    mutation before CoreCompile and repairs late historical staging mismatches that
    are valid PowerShell/C# syntax but fail against the real Civil 3D 2023 API or
    current helper signatures.
  -->
  <Target Name="CEApplyAugust24FinalCompileCompatibility"
          AfterTargets="CEApplyAugust24DynamicGridCivilSurfaceCompileFix"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'CE.Tools.Civil3D' and '$(AutoCADVersion)' == '2023' and '$(OS)' == 'Windows_NT'">
    <Message Text="Applying final Civil 3D 2023 compile compatibility boundary..." Importance="high" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\Repair-August24-FinalCompileCompatibility-Civil3D2023.ps1&quot; -RepoRoot &quot;$(MSBuildThisFileDirectory)&quot;" />
  </Target>
</Project>
